---
layout: null
permalink: /search-index.json
sitemap: false
---
[
{%- for post in site.posts -%}
  {
    "title": {{ post.title | escape | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {{ post.tags | default: post.categories | join: ", " | jsonify }},
    "excerpt": {{ post.content | strip_html | normalize_whitespace | truncate: 200 | jsonify }},
    "body": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
